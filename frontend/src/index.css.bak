*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Inter;
    background:#C1DBF2;
    color:#1f2937;
}

a{
    text-decoration:none;
}

.app{
    display:flex;
    min-height:100vh;
}

/* =========================
   SIDEBAR
========================= */

.sidebar{
    width:270px;
    background:#050934;
    color:#f8fafb0e;
    border-right:1px solid #e5e7eb;
    padding:20px;
    overflow-y:auto;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:30px;
}

.brand-logo{
    width:50px;
    height:50px;
    border-radius:14px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-weight:500;
    font-size:10px;

    background:linear-gradient(
        135deg,
        #04293c0e,
        #f0f2f3
    );

    color:white;
}

.logo h3{
    font-size:30px;
    color:#f8fafb0e;
}

.sidebar nav{
    display:flex;
    flex-direction:column;
    gap:6px;
}

.menu-section{
    margin-top:25px;
}

.menu-title{
    display:flex;
    justify-content:space-between;
    align-items:center;

    font-size:14px;
    font-weight:700;
    color:#f8fafb0e;

    margin-bottom:10px;
}

.menu-section a{
    display:flex;
    align-items:center;
    gap:12px;

    padding:12px 14px;

    border-radius:12px;

    color:#475569;
    font-weight:500;

    transition:all .2s ease;
}

.menu-section a:hover{
    background:#bae6fd;
    color:#2563eb;
}

.menu-section a.active{
    background:#2563eb;
    color:white;
}

.submenu{
    display:flex;
    flex-direction:column;
    gap:4px;
}

.submenu a{
    padding-left:14px;
}

/* =========================
   MAIN CONTENT
========================= */

.content{
    flex:1;
    display:flex;
    flex-direction:column;
}

/* =========================
   TOP BAR
========================= */

.topbar{
    height:72px;

    background:white;

    border-bottom:1px solid #e8edf5;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:0 30px;
}

.topbar-left{
    display:flex;
    align-items:center;
    gap:14px;
}

.topbar-left h2{
    font-size:22px;
}

.topbar-right{
    display:flex;
    align-items:center;
    gap:20px;
}

.avatar{
    width:38px;
    height:36px;

    border-radius:50%;

    background:#C1DBF2;
}

/* =========================
   PAGE
========================= */

.page{
    padding:16px;
}


/* =========================
   STATISTICS
========================= */

.stats{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:16px;
    margin-bottom:24px;
}

.stat-card{
    background:#f0f9ff;

    border-radius:12px;

    padding:10px 12px;

    border-top:3px solid #38bdf8;

    box-shadow:
        0 4px 12px rgba(15,23,42,.04);

    transition:.2s;
}

.stat-card:hover{
    transform:translateY(-2px);

    box-shadow:
        0 10px 24px rgba(37,99,235,.08);
}

.stat-card h3{
    color:#64748b;
    font-size:10px;
    font-weight:600;
    margin:0 0 4px;
}

.stat-card p{
    font-size:18px;
    font-weight:700;
    line-height:1.1;
}

.stat-card small{
    display:block;
    margin-top:4px;
    font-size:10px;
    color:#94a3b8;
}

/* =========================
   DASHBOARD GRID
========================= */

.dashboard-grid{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:20px;
}

.panel{
    background:white;

    border-radius:18px;

    padding:24px;

    box-shadow:
        0 6px 25px rgba(0,0,0,.05);
}

.panel-header{
    display:flex;
    justify-content:space-between;
    align-items:center;

    margin-bottom:20px;
}

.placeholder-chart{
    height:350px;

    border-radius:14px;

    display:flex;
    align-items:center;
    justify-content:center;

    color:#94a3b8;

    background:linear-gradient(
        135deg,
        #eff6ff,
        #f8fafc
    );

    border:2px dashed #dbe2ef;
}

/* =========================
   QUICK ACTIONS
========================= */

.quick-actions{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.quick-action{
    background:#f8fafc;

    border:1px solid #edf2f7;
    border-left:4px solid #2563eb;

    border-radius:12px;

    padding:16px;

    transition:all .2s ease;
}

.quick-action:hover{
    background:#eff6ff;
    transform:translateY(-2px);
}

.quick-action h4{
    margin-bottom:6px;
}

.quick-action p{
    color:#64748b;
    font-size:14px;
}
.menu-title{
  width:100%;
  border:none;
  background:transparent;
  cursor:pointer;

  display:flex;
  justify-content:space-between;
  align-items:center;

  padding:10px 0;
  font-size:14px;
  font-weight:700;
  color:#475569;
}

.rotate{
  transform:rotate(180deg);
  transition:.25s;
}

.submenu{
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-top:8px;
}

.submenu a{
  padding:12px 14px;
  margin-left:10px;
  border-radius:12px;
}

.submenu a:hover{
  background:#eff6ff;
  color:#2563eb;
}